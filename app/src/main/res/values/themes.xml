<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RenovationLedger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Material 控件（Toolbar / FAB / TabLayout / AppCompat Dialog）需要该主题 -->
    <style name="Theme.RenovationLedger.Debug" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#FF6B00</item>
        <item name="colorPrimaryVariant">#E05F00</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RenovationLedger.Debug.FullScreenDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowBackground">@color/F4</item>
    </style>
</resources>
