<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/F4"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:paddingHorizontal="@dimen/dimen_8">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_debug_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dimen_24"
            android:textColor="@color/F1"
            android:textSize="@dimen/dimen_16"
            android:textStyle="bold" />
    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:background="@color/debug_tab_bg"
        app:tabIndicatorColor="@color/debug_primary"
        app:tabIndicatorHeight="@dimen/dimen_2"
        app:tabRippleColor="@color/debug_primary"
        app:tabSelectedTextColor="@color/debug_primary"
        app:tabTextColor="@color/F1" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_0"
        android:layout_weight="1" />
</LinearLayout>
